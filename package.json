{
  "name": "naturatins",
  "version": "1.0.0",
  "description": "Sistema Interno Naturatins",

  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {

    "appId": "com.naturatins.app",
    "productName": "Sistema Naturatins",
    "artifactName": "Sistema-Naturatins-Setup.${ext}",
    "win": {
      "target": "nsis",
      "icon": "Imagens/Logo-naturatins.ico"
    }
  },
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],

    "asar": true,

    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./Imagens/Logo-naturatins.ico",
      "uninstallerIcon": "./Imagens/Logo-naturatins.ico",
      "installerHeaderIcon": "./Imagens/Logo-naturatins.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
}
